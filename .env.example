# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key for signing user session cookies (auto-generated fallback in dev).
SESSION_SECRET="change-me-in-production"

# ADSENSE_PUBLISHER_ID: Optional Google AdSense Publisher ID (e.g. ca-pub-xxxxxxxxxxxxxxxx).
# Leave empty until AdSense approval is complete. Ads remain disabled when unset.
ADSENSE_PUBLISHER_ID=""

# GAM_REWARDED_AD_UNIT: Optional Google Ad Manager Rewarded Ad Unit path
# (e.g. /1234567/voxcraft_rewarded_boost) for opt-in bonus daily characters.
GAM_REWARDED_AD_UNIT=""

